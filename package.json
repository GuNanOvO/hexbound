{
  "name": "hexbound",
  "version": "0.1.0",
  "description": "A restrictive TypeScript and Next.js coding dialect for agents, backed by executable checks.",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "hexbound": "dist/cli.js" },
  "exports": { ".": "./dist/index.js", "./eslint": "./dist/eslint.js", "./policy": "./dist/policy.js" },
  "files": ["dist", "skills", "docs", "evals", "examples/patterns", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:patterns": "tsc -p tsconfig.patterns.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run build && npm run typecheck:patterns && npm test",
    "example:dev": "next dev examples/next-app --hostname 127.0.0.1",
    "example:build": "next build examples/next-app"
  },
  "dependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "tsx": "^4.20.0"
  }
}
