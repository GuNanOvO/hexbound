{
  "version": 1,
  "rulesVersion": "0.1.0",
  "businessRoots": [
    "domain",
    "src/domain"
  ],
  "serverRoots": [
    "server",
    "src/server"
  ],
  "serverServicesRoots": [
    "server/services",
    "src/server/services"
  ],
  "effectRoots": [
    "hooks/effects",
    "src/hooks/effects"
  ],
  "dataRoots": [
    "server/data",
    "src/server/data"
  ],
  "validationRoots": [
    "validation",
    "src/validation"
  ],
  "cacheRoots": [],
  "envFiles": [
    "env/server.ts",
